{
  "name": "marginalia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "bash scripts/deploy.sh",
    "host:install": "npm --prefix host install",
    "host:check": "tsc -p host/tsconfig.json",
    "host:build": "npm run host:check && vite build --config host/vite.config.ts",
    "host": "npm run host:build && node host/dist/main.js"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "pdfjs-dist": "^6.5.438",
    "perfect-freehand": "^1.2.3",
    "preact": "^11.0.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.2",
    "happy-dom": "^21.0.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
